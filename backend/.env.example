# Copy to backend/.env and fill in only if you want the optional LLM layer.
# Without a key the copilot runs fully deterministically (no model calls needed).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Point at a different dataset (e.g. the test dataset released in the final 2 hours).
# COPILOT_DATA_DIR=/absolute/path/to/test-data
# COPILOT_TODAY=2026-10-16T00:00:00+00:00
