# Copy to backend/.env and fill in only if you want the optional LLM layer.
# Without a provider configured the copilot runs fully deterministically
# (no model calls needed).

# --- Option A: local Ollama (no API key needed) -----------------------------
# Requires Ollama running locally with the model pulled, e.g.:
#   ollama pull gemma3:4b
#LLM_PROVIDER=ollama
#OLLAMA_BASE_URL=http://localhost:11434/v1
#OLLAMA_MODEL=gemma3:4b

# --- Option B: OpenRouter (default provider) --------------------------------
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Generic overrides (work for either provider) ---------------------------
#LLM_BASE_URL=            # override the provider's base URL
#LLM_MODEL=               # override the provider's model
#LLM_API_KEY=             # override the provider's API key
#COPILOT_LLM_TIMEOUT=40   # seconds before an LLM call is abandoned
#COPILOT_LLM_DISABLE=1    # hard off-switch, even if a key/model is set

# Point at a different dataset (e.g. the test dataset released in the final 2 hours).
# COPILOT_DATA_DIR=/absolute/path/to/test-data
# COPILOT_TODAY=2026-10-16T00:00:00+00:00
